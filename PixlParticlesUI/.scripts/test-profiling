#!/bin/sh
set -eu
project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
profiling_package=$(mktemp -d /private/tmp/pixl-profiling-tests.XXXXXX)
trap 'rm -rf "$profiling_package"' EXIT
mkdir -p "$profiling_package/Sources/ParticleProfiling" "$profiling_package/Tests/ParticleProfilingTests"
cp "$project_root"/Views/Rendering/Profiling/*.swift "$profiling_package/Sources/ParticleProfiling/"
cp "$project_root"/Tests/Profiling/*.swift "$profiling_package/Tests/ParticleProfilingTests/"
cat > "$profiling_package/Package.swift" <<'PACKAGE'
// swift-tools-version: 6.3
import PackageDescription
let package = Package(
    name: "ParticleProfiling",
    platforms: [.macOS(.v15)],
    targets: [
        .target(name: "ParticleProfiling", swiftSettings: [.defaultIsolation(MainActor.self)]),
        .testTarget(name: "ParticleProfilingTests", dependencies: ["ParticleProfiling"])
    ],
    swiftLanguageModes: [.v5]
)
PACKAGE
swift test --package-path "$profiling_package" --build-system native "$@"
