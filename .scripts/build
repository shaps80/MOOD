#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
PACKAGE_DIR="${ROOT_DIR}/${1:-Game}"

if [[ ! -f "${PACKAGE_DIR}/Package.swift" ]]; then
  echo "error: Package.swift not found at ${PACKAGE_DIR}" >&2
  exit 1
fi

cd "${PACKAGE_DIR}"

CONFIGURATION="release"
SDK="swift-6.4.x-DEVELOPMENT-SNAPSHOT-2026-07-17-a_wasm"
TOOLCHAIN="6.4.x-snapshot-2026-07-17"
TARGET="${2:-${1:-Game}}"

swiftly run swift build   --scratch-path ".build/wasm-${TARGET}"   --swift-sdk "${SDK}"   --target "${TARGET}"   -c "${CONFIGURATION}"   +"${TOOLCHAIN}"
