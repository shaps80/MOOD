#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
source "${SCRIPT_DIR}/_web-toolchain"
ensure_web_toolchain
PACKAGE_DIR="${ROOT_DIR}/${1:-Game}"

if [[ ! -f "${PACKAGE_DIR}/Package.swift" ]]; then
  echo "error: Package.swift not found at ${PACKAGE_DIR}" >&2
  exit 1
fi

cd "${PACKAGE_DIR}"

CONFIGURATION="release"
TARGET="${2:-${1:-Game}}"

swiftly run swift build   --scratch-path ".build/wasm-${TARGET}"   --swift-sdk "${WEB_SDK}"   --target "${TARGET}"   -c "${CONFIGURATION}"   +"${WEB_TOOLCHAIN}"
