#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
PACKAGE_DIR="${ROOT_DIR}/Pixl"

if [[ ! -f "${PACKAGE_DIR}/Package.swift" ]]; then
  echo "error: Package.swift not found at ${PACKAGE_DIR}" >&2
  exit 1
fi

cd "${PACKAGE_DIR}"

CONFIGURATION="release"
SDK="swift-6.3.2-RELEASE_wasm"
TARGET="${1:-Pixl}"

swiftly run swift build   --scratch-path ".build/wasm-${TARGET}"   --swift-sdk "${SDK}"   --target "${TARGET}"   -c "${CONFIGURATION}"
