#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
PACKAGE_DIR="${ROOT_DIR}/Pixl"

if [[ ! -f "${PACKAGE_DIR}/Package.swift" ]]; then
  echo "error: Package.swift not found at ${PACKAGE_DIR}" >&2
  exit 1
fi

cd "${PACKAGE_DIR}"

PORT=9999
URL="http://127.0.0.1:${PORT}/"
DIST_DIR=".dist"
PRODUCT="${1:?Usage: ./.scripts/serve <product>}"

"${SCRIPT_DIR}/_package-web" "${PRODUCT}"

echo
echo "Pixl running at:"
echo "${URL}"
echo "Product: ${PRODUCT}"
echo "Configuration: release"
echo
echo "Press Ctrl-C to stop."

python3 -m http.server "${PORT}" --directory "${DIST_DIR}"
