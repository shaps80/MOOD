#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "${ROOT_DIR}"

PRODUCT="${1:?Usage: ./.scripts/deploy <product>}"
DIST_DIR=".dist"
ZIP_PATH="${PRODUCT}.zip"

rm -f "${ZIP_PATH}"
"${SCRIPT_DIR}/_package-web" "${PRODUCT}"

(
  cd "${DIST_DIR}"
  zip -qr "../${ZIP_PATH}" .
)

echo
echo "Pixl itch package built."
echo "Product: ${PRODUCT}"
echo "Itch upload: ${ZIP_PATH}"
