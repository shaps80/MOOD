#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
MODE="${1:-native}"

case "${MODE}" in
  native)
    swiftly run swift run \
      --package-path "${ROOT_DIR}/Pixl" \
      -c release \
      PixlBenchmarks \
      "${@:2}"
    ;;
  wasm)
    "${SCRIPT_DIR}/_benchmark-wasm" "${@:2}"
    ;;
  *)
    echo "usage: ./.scripts/benchmark [native|wasm] [--json]" >&2
    exit 1
    ;;
esac
