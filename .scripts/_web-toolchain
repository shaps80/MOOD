#!/usr/bin/env bash

WEB_TOOLCHAIN="6.4.x-snapshot-2026-08-26"
WEB_SDK="swift-6.4.x-DEVELOPMENT-SNAPSHOT-2026-08-26-a_wasm"
WEB_SDK_URL="https://download.swift.org/swift-6.4.x-branch/wasm-sdk/swift-6.4.x-DEVELOPMENT-SNAPSHOT-2026-08-26-a/swift-6.4.x-DEVELOPMENT-SNAPSHOT-2026-08-26-a_wasm.artifactbundle.tar.gz"
WEB_SDK_CHECKSUM="fbaa7e01a96ab237cc639ece25af620ec162336d57633858c2d6454af87d878c"

ensure_web_toolchain() {
  if ! command -v swiftly >/dev/null 2>&1; then
    echo "error: swiftly is required: https://www.swift.org/install/" >&2
    exit 1
  fi

  if ! swiftly run swift --version +"${WEB_TOOLCHAIN}" >/dev/null 2>&1; then
    echo "Installing Swift ${WEB_TOOLCHAIN}..."
    swiftly install "${WEB_TOOLCHAIN}" --assume-yes
  fi

  if ! swiftly run swift sdk list +"${WEB_TOOLCHAIN}" | grep -Fxq "${WEB_SDK}"; then
    echo "Installing Swift WebAssembly SDK ${WEB_SDK}..."
    swiftly run swift sdk install \
      "${WEB_SDK_URL}" \
      --checksum "${WEB_SDK_CHECKSUM}" \
      +"${WEB_TOOLCHAIN}"
  fi
}
