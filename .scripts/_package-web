#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
PROJECT_DIR="${ROOT_DIR}/${1:-Game}"

if [[ ! -f "${PROJECT_DIR}/Package.swift" ]]; then
  echo "error: Package.swift not found at ${PROJECT_DIR}" >&2
  exit 1
fi

CONFIGURATION="release"
PRODUCT="${2:-${1:-Game}}"
SDK="swift-6.3.2-RELEASE_wasm"
WRAPPER_DIR="${PROJECT_DIR}/.build/wasm-package"
PACKAGE_DIR="${WRAPPER_DIR}/.build/package"
DIST_DIR="${PROJECT_DIR}/.dist"

write_index_html() {
  local output_path="$1"

  cat > "${output_path}" <<HTML
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="data:,">
  <title>${PRODUCT}</title>
</head>
<body>
  <script type="module">
    import { init } from "./pixl.js";

    const paths = await fetch("./assets.json").then(response => response.json());
    const entries = await Promise.all(paths.map(async path => {
      const response = await fetch("./Assets/" + path);
      if (!response.ok) {
        throw new Error(
          "Unable to load asset '" + path + "': " + response.status
        );
      }
      return [path, new Uint8Array(await response.arrayBuffer())];
    }));
    globalThis.__pixlAssets = Object.fromEntries(entries);

    await init();
  </script>
</body>
</html>
HTML
}

copy_assets() {
  local assets_dir="${PROJECT_DIR}/Assets"

  mkdir -p "${DIST_DIR}/Assets"

  if [[ -d "${assets_dir}" ]]; then
    cp -R "${assets_dir}/." "${DIST_DIR}/Assets/"
  fi
}

copy_builtin_assets() {
  local shader_path="${ROOT_DIR}/PixlPlatform/Sources/PixlWasmPlatform/Shaders/Shaders.wgsl"

  mkdir -p "${DIST_DIR}/Assets/__pixl"
  cp "${shader_path}" "${DIST_DIR}/Assets/__pixl/Shaders.wgsl"
}

write_assets_manifest() {
  python3 -c '
import json
import pathlib
import sys

root = pathlib.Path(sys.argv[1])
paths = sorted(
    path.relative_to(root).as_posix()
    for path in root.rglob("*")
    if path.is_file()
    and not any(part.startswith(".") for part in path.relative_to(root).parts)
)
pathlib.Path(sys.argv[2]).write_text(json.dumps(paths), encoding="utf-8")
' "${DIST_DIR}/Assets" "${DIST_DIR}/assets.json"
}

copy_target_resources() {
  local resource_paths=()

  while IFS= read -r resource_path; do
    resource_paths+=("${resource_path}")
  done < <(
    swiftly run swift package --package-path "${PROJECT_DIR}" dump-package | python3 -c '
import json
import pathlib
import sys

data = json.load(sys.stdin)
product = sys.argv[1]
root = pathlib.Path(data["packageKind"]["root"][0])

for target in data["targets"]:
    if target["name"] != product:
        continue

    target_path = root / (target.get("path") or f"Sources/{product}")
    for resource in target.get("resources", []):
        print((target_path / resource["path"]).resolve())
    break
' "${PRODUCT}"
  )

  if (( ${#resource_paths[@]} == 0 )); then
    return
  fi

  for resource_path in "${resource_paths[@]}"; do
    if [[ ! -e "${resource_path}" ]]; then
      echo "Missing resource: ${resource_path}" >&2
      exit 1
    fi

    cp -R "${resource_path}" "${DIST_DIR}/"
  done
}

rm -rf "${WRAPPER_DIR}/Sources" "${PACKAGE_DIR}" "${DIST_DIR}"
mkdir -p "${WRAPPER_DIR}/Sources" "${PACKAGE_DIR}" "${DIST_DIR}"
cp -R "${PROJECT_DIR}/Sources/${PRODUCT}" "${WRAPPER_DIR}/Sources/${PRODUCT}"

cat > "${WRAPPER_DIR}/Package.swift" <<SWIFT
// swift-tools-version: 6.3
import PackageDescription

let package = Package(
    name: "${PRODUCT}WasmPackage",
    dependencies: [
        .package(path: "${ROOT_DIR}/Pixl"),
        .package(
            url: "https://github.com/swiftwasm/JavaScriptKit.git",
            from: "0.55.0"
        )
    ],
    targets: [
        .executableTarget(
            name: "${PRODUCT}",
            dependencies: [
                .product(name: "Pixl", package: "Pixl")
            ]
        )
    ],
    swiftLanguageModes: [.v6]
)
SWIFT

swiftly run swift package   --package-path "${WRAPPER_DIR}"   --swift-sdk "${SDK}"   --allow-writing-to-package-directory   js   --product "${PRODUCT}"   -c "${CONFIGURATION}"   --debug-info-format none   --output "${PACKAGE_DIR}"

npm install --prefix "${PACKAGE_DIR}" --omit=dev
npx --yes esbuild "${PACKAGE_DIR}/index.js"   --bundle   --format=esm   --minify   --platform=browser   --legal-comments=none   --outfile="${DIST_DIR}/pixl.js"

cp "${PACKAGE_DIR}/${PRODUCT}.wasm" "${DIST_DIR}/${PRODUCT}.wasm"
copy_assets
copy_builtin_assets
write_assets_manifest
copy_target_resources
write_index_html "${DIST_DIR}/index.html"

echo
echo "Pixl browser package built."
echo "Product: ${PRODUCT}"
echo "Configuration: ${CONFIGURATION}"
echo "Dist: ${DIST_DIR}/"
