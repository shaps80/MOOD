#!/bin/bash
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
build=$(mktemp -d /private/tmp/pixl-profiler-benchmark.XXXXXX)
trap 'rm -rf "$build"' EXIT
export CLANG_MODULE_CACHE_PATH="$build/cache"
xcrun clang -O2 -dynamiclib "$root/Benchmarks/AllocationProbe.c" -o "$build/libProfilerAllocationProbe.dylib"
sources=()
while IFS= read -r file; do sources+=("$file"); done < <(find "$root/Sources/PixlProfiler" -name '*.swift' | sort)
xcrun swiftc -O -whole-module-optimization -swift-version 6 -module-name PixlProfilerBenchmark "${sources[@]}" "$root/Benchmarks/RecordingBenchmarks.swift" -L "$build" -lProfilerAllocationProbe -Xlinker -rpath -Xlinker "$build" -o "$build/benchmark"
"$build/benchmark"
